generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-owner site: exactly one Profile row (id = 1)
model Profile {
  id        Int    @id @default(1)
  name      String @default("Your Name")
  role      String @default("Your Role")
  headline  String @default("Hi, I'm")
  bio       String @default("")
  about     String @default("")
  avatarUrl String @default("")
  github    String @default("")
  email     String @default("")
  linkedin  String @default("")
  colorCream     String @default("#f6f1e7")
  colorInk       String @default("#141414")
  colorAmber     String @default("#f5a623")
  colorAmberDeep String @default("#e8890c")
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  position Int     @default(0)
  skills   Skill[]
}

model Skill {
  id          Int       @id @default(autoincrement())
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  Int?
  name        String
  description String    @default("")
  position    Int       @default(0)
  projects    SkillProject[]
}

model Project {
  id      Int    @id @default(autoincrement())
  title   String
  url     String
  // column kept as "note" in the DB so existing text survives the rename
  description String @default("") @map("note")
  tags   String[] @default([])
  skills SkillProject[]
}

// Explicit join so each skill can order its own projects.
model SkillProject {
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  position  Int     @default(0)

  @@id([skillId, projectId])
}
